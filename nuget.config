<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- GitHub Packages needs a token even for a public package. Never put one in this file:
         set NuGetPackageSourceCredentials_github="Username=<login>;Password=<token>" in the
         environment (CI: the job's GITHUB_TOKEN with packages: read). -->
    <add key="github" value="https://nuget.pkg.github.com/neijix/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="github">
      <package pattern="D3sk.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
