<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>D3sk.ChatUi</PackageId>
    <Description>D3SKHAND's chat rules with no UI types: the session that folds D3sk.AgentCli turn events into what the chat shows, labels, tool summaries, markdown to safe HTML. Shared spec with the web package @d3sk/chat-ui.</Description>
    <Authors>neijix</Authors>
    <Copyright>Copyright (c) 2026 neijix</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/neijix/D3sk.ChatUi</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/neijix/D3sk.ChatUi</PackageProjectUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <!-- The shared spec: the web package @d3sk/chat-ui reads the same file. -->
    <EmbeddedResource Include="../../spec/chat-ui.json" LogicalName="D3sk.ChatUi.chat-ui.json" />
  </ItemGroup>
</Project>
