<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>D3sk.ChatUi</PackageId>
    <Description>Chat transcript rules for D3SKHAND with no UI types: markdown to safe HTML, status labels, view models.</Description>
    <Authors>neijix</Authors>
    <Copyright>Copyright (c) 2026 neijix</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/neijix/D3sk.ChatUi</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/neijix/D3sk.ChatUi</PackageProjectUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
