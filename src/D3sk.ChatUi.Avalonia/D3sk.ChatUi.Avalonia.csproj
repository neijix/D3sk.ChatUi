<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>D3sk.ChatUi.Avalonia</PackageId>
    <Description>D3SKHAND's chat for Avalonia: ChatView with the virtualized transcript, working line, approvals and composer, fed with D3sk.AgentCli turn events.</Description>
    <Authors>neijix</Authors>
    <Copyright>Copyright (c) 2026 neijix</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/neijix/D3sk.ChatUi</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/neijix/D3sk.ChatUi</PackageProjectUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <ProjectReference Include="../D3sk.ChatUi/D3sk.ChatUi.csproj" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
